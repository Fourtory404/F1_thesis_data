# 1. Revenue Trends Chart (Top Left)
ax1 = plt.subplot(2, 3, 1)
for team, revenues in revenue_data.items():
    ax1.plot(years, revenues, marker='o', label=team, color=team_colors[team], linewidth=2)
ax1.axvline(x=2020.5, color='red', linestyle='--', linewidth=2)
ax1.axvspan(2021, 2024, alpha=0.1, color='orange')
ax1.set_xlabel('Year', fontsize=11, fontweight='bold')
ax1.set_ylabel('Revenue (Million USD)', fontsize=11, fontweight='bold')
ax1.set_title('Revenue Trends: All F1 Teams (2016-2024)', fontsize=13, fontweight='bold', pad=10)
ax1.legend(loc='upper left', fontsize=8, ncol=2)
ax1.grid(True, alpha=0.3)
